<odoo>
    <data noupdate="1">
        <!-- Define the new stock locations -->
        <record id="stock_location_installed_signs" model="stock.location">
            <field name="name">Installed Signs</field>
            <field name="location_id" ref="stock.stock_location_locations_virtual"/>
            <field name="usage">internal</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <record id="stock_location_stored_signs" model="stock.location">
            <field name="name">Stored Signs</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
            <field name="usage">internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="return_location">true</field>
        </record>

        <!-- Define the sequences -->
        <record id="ir_sequence_realtor_sign_installation" model="ir.sequence">
            <field name="name">Realtor Sign Installation Sequence</field>
            <field name="code">RSI</field>
            <field name="implementation">standard</field>
            <field name="prefix">WH/OUT/RSI/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="ir_sequence_realtor_sign_removal" model="ir.sequence">
            <field name="name">Realtor Sign Removal Sequence</field>
            <field name="code">RSR</field>
            <field name="implementation">standard</field>
            <field name="prefix">WH/IN/RSR/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="ir_sequence_realtor_sign_receipt" model="ir.sequence">
            <field name="name">Realtor Sign Receipts Sequence</field>
            <field name="code">RST</field>
            <field name="implementation">standard</field>
            <field name="prefix">WH/IN/RST/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Define the picking types -->
        <record id="picking_type_realtor_sign_removal" model="stock.picking.type">
            <field name="name">Realtor Sign Removal</field>
            <field name="code">internal</field>
            <field name="sequence_id" ref="ir_sequence_realtor_sign_removal" />
            <field name="sequence_code">RSR</field>
            <field name="default_location_src_id" ref="stock_location_installed_signs"/>
            <field name="default_location_dest_id" ref="stock_location_stored_signs"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="create_backorder">never</field>
            <field name="use_create_lots">false</field>
            <field name="use_existing_lots">false</field>
        </record>
        <record id="picking_type_realtor_sign_installation" model="stock.picking.type">
            <field name="name">Realtor Sign Installation</field>
            <field name="code">internal</field>
            <field name="sequence_id" ref="ir_sequence_realtor_sign_installation" />
            <field name="sequence_code">RSI</field>
            <field name="default_location_src_id" ref="stock_location_stored_signs"/>
            <field name="default_location_dest_id" ref="stock_location_installed_signs"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="return_picking_type_id" ref="picking_type_realtor_sign_removal" />
            <field name="create_backorder">never</field>
            <field name="use_create_lots">false</field>
            <field name="use_existing_lots">false</field>
        </record>
        <record id="picking_type_realtor_sign_receipt" model="stock.picking.type">
            <field name="name">Realtor Sign Receipt</field>
            <field name="code">incoming</field>
            <field name="sequence_id" ref="ir_sequence_realtor_sign_receipt" />
            <field name="sequence_code">RST</field>
            <field name="default_location_src_id" ref="stock.stock_location_customers"/>
            <field name="default_location_dest_id" ref="stock_location_stored_signs"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="create_backorder">never</field>
            <field name="use_create_lots">true</field>
            <field name="use_existing_lots">true</field>
        </record>

    </data>
</odoo>
