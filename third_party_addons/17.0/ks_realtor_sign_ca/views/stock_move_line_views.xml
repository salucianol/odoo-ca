<odoo>
    <data>
        <record id="ks_reltor_sign_view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
            <field name="name">ks.realtor.sign.stock.move.line.operations.inherit.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <field name="location_dest_id" position="after">
                    <field name="picking_id" invisible="0" />
                    <field name="installation_address"
                        required="picking_id.is_picking_type_realtor_sign_installation == True"
                        invisible="picking_id.is_picking_type_realtor_sign_installation == False" />
                </field>
            </field>
        </record>
    </data>
</odoo>