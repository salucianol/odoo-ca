<odoo>
    <data>
        <template id="ks_report_payment_receipt_document" inherit_id="account.report_payment_receipt_document">
            <xpath expr="//div[@class='page']//div" position="replace">
                <div class="mb-4 mt-3">
                    <div name="customer" class="row">
                        <div class="col-6 offset-7" t-if="o.partner_type">
                            <t t-if="o.partner_type == 'customer'">
                                Customer:
                            </t>
                            <t t-else="o.partner_type == 'supplier'">
                                Vendor:
                            </t>
                            <address t-field="o.partner_id" 
                                t-options="{'widget': 'contact',
                                            'fields': ['name', 'address', 'email', 'phone', 'mobile'],
                                            'no_marker': True}">Marc Demo</address>
                        </div>
                    </div>
                    <div name="payment_text" class="row">
                        <div class="col-12">
                            <h2 style="color: #f7931e !important;"><strong id="payment_title">Payment Receipt</strong></h2>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[@class='page']//h3" position="replace" />

            <xpath expr="//div[@class='page']" position="attributes">
                <attribute name="class" add="page pt-4" />
            </xpath>

            <xpath expr="//table[@name='invoices']" position="replace">
                <t t-set="partials" t-value="o.move_id._get_reconciled_invoices_partials()[0]"/>
                <t t-set="invoices" t-value="{partial[2].move_id for partial in partials}"/>
                <!-- Check if invoices include different currencies -->
                <t t-foreach="invoices" t-as="inv">
                    <t t-if="any(inv.currency_id != par[2].currency_id for par in inv._get_reconciled_invoices_partials()[0])" 
                        t-set="otherCurrency" t-value="True"/>
                </t>
                <t t-foreach="invoices" t-as="inv">
                    <!-- MOVE -->
                    <h4 style="color: #4d4d4d !important;"><strong>Invoice</strong></h4>
                    <table name="invoice"
                        t-if="values['display_invoices']"
                        class="table table-sm mb-4">
                        <thead>
                            <tr>
                                <th><span>Date</span></th>
                                <th><span>Number</span></th>
                                <th><span>Reference</span></th>
                                <!-- Add a column if there are different currencies -->
                                <th t-if="otherCurrency" class="text-end"><span>Amount In Currency</span></th>
                                <th class="text-end"><span>Amount</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="inv.move_type != 'entry'">
                                <tr>
                                    <td><span t-field="inv.invoice_date">2023-01-01</span></td>
                                    <td><span t-field="inv.name">INV001</span></td>
                                    <td><span t-field="inv.ref">Sample Ref</span></td>
                                    <td t-if="otherCurrency"/>
                                    <td class="text-end"><span t-field="inv.amount_total">100.00 USD</span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <!-- PAYMENTS/REVERSALS -->
                    <h4 style="color: #4d4d4d !important;"><strong>Payments</strong></h4>
                    <table name="payments" 
                        t-if="values['display_invoices']"
                        class="table table-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th><span>Date</span></th>
                                <th><span>Number</span></th>
                                <th><span>Invoice Reference</span></th>
                                <!-- Add a column if there are different currencies -->
                                <th t-if="otherCurrency" class="text-end"><span>Amount In Currency</span></th>
                                <th class="text-end"><span>Amount</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="payment_number" t-value="1"/>
                            <tr t-foreach="inv._get_reconciled_invoices_partials()[0]" t-as="par">
                                <t t-set="payment" t-value="par[2].move_id"/>
                                <td><span t-esc="payment_number"/></td>
                                <td><span t-field="payment.date">2023-01-05</span></td>
                                <td><span t-field="payment.name">PAY001</span></td>
                                <td><span t-field="payment.ref">Payment Ref</span></td>
                                <t t-set="amountPayment" t-value="-payment.amount_total"/>
                                <t t-set="amountInvoice" t-value="-par[1]"/>
                                <t t-set="currencyPayment" t-value="payment.currency_id"/>
                                <t t-set="currencyInvoice" t-value="inv.currency_id"/>
                                <!-- Fill the column "Amount In Currency" only if necessary -->
                                <td t-if="otherCurrency" class="text-end">
                                    <span t-if="currencyPayment != currencyInvoice" t-out="amountPayment" 
                                        t-options="{'widget': 'monetary', 'display_currency': currencyPayment}">50.00 EUR</span>
                                </td>
                                <td class="text-end"><span t-out="amountInvoice" 
                                    t-options="{'widget': 'monetary', 
                                                'display_currency': currencyInvoice}">25.00 USD</span></td>
                                <t t-set="payment_number" t-value="payment_number + 1"/>
                            </tr>
                            <!-- BALANCE -->
                            <tr>
                                <td/>
                                <td/>
                                <td><strong>Due Amount for <span t-field="inv.name">INV001</span></strong></td>
                                <td/>
                                <td t-if="otherCurrency"/>
                                <td class="text-end"><strong><span t-field="inv.amount_residual">25.0 USD</span></strong></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </xpath>
        </template>
    </data>
</odoo>